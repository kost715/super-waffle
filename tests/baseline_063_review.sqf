// Production functions from the supplied PBO; engine/transport boundaries are fixtures.
call TEST_fnc_reset;
private _job = createHashMapFromArray [["alspmcFounder","p1"]];
private _crew = createHashMapFromArray [["leader","p2"]];
[["p1",_job,_crew] call ALSPMC_fnc_contractBoss,"online founder retains command after native leader handover"] call TEST_fnc_assert;
[!(["p2",_job,_crew] call ALSPMC_fnc_contractBoss),"new leader cannot override an online founder"] call TEST_fnc_assert;
[!(["p3",_job,_crew] call ALSPMC_fnc_contractBoss),"unrelated participant cannot command the operation"] call TEST_fnc_assert;
private _finder = ALS_fnc_findPlayer;
ALS_fnc_findPlayer = {objNull};
[["p2",_job,_crew] call ALSPMC_fnc_contractBoss,"current leader may command while founder is offline"] call TEST_fnc_assert;
[!(["p3",_job,_crew] call ALSPMC_fnc_contractBoss),"offline founder does not grant command to everyone"] call TEST_fnc_assert;
ALS_fnc_findPlayer = _finder;
[["p2",createHashMap,_crew] call ALSPMC_fnc_contractBoss,"legacy operation without founder uses the native leader"] call TEST_fnc_assert;

player setVariable ["ALSPMC_phoneState",nil];
private _state = createHashMapFromArray [["reply",55],["ok",true]];
TEST_hasInterface=false;
["ALSPMC_phoneState",_state] call ALSPMC_fnc_stateSet;
[isNil {player getVariable "ALSPMC_phoneState"},"state receiver does not write a player state on dedicated server"] call TEST_fnc_assert;
TEST_hasInterface=true; TEST_isRemoteExecuted=true; TEST_remoteOwner=4;
["ALSPMC_phoneState",_state] call ALSPMC_fnc_stateSet;
[isNil {player getVariable "ALSPMC_phoneState"},"client-origin state packet is rejected"] call TEST_fnc_assert;
TEST_remoteOwner=2;
["ALSPMC_phoneState",_state] call ALSPMC_fnc_stateSet;
[(player getVariable "ALSPMC_phoneState") isEqualTo _state,"server-origin phone packet reaches the local client state"] call TEST_fnc_assert;
["ALSPMC_desktopState",_state] call ALSPMC_fnc_stateSet;
[(player getVariable "ALSPMC_desktopState") isEqualTo _state,"server-origin desktop packet reaches the local client state"] call TEST_fnc_assert;
["ALS_money",_state] call ALSPMC_fnc_stateSet;
[!((player getVariable ["ALS_money",[]]) isEqualTo _state),"state receiver rejects unrelated variable names"] call TEST_fnc_assert;
TEST_hasInterface=false; TEST_isRemoteExecuted=false;

call TEST_fnc_reset;
["p1","alspmc_pmc"] call ALS_fnc_licGrant;
[player,"h_100_100"] call ALSPMC_fnc_buyBase;
call ALSPMC_fnc_questInit;
TEST_messages=[];
[player,101,true] call ALSPMC_fnc_phoneSync;
private _privatePackets=TEST_messages select {((_x select 1) select 0)=="ALSPMC_fnc_stateSet"};
[count _privatePackets==1 && {((_privatePackets select 0) select 1) isEqualTo ["ALSPMC_fnc_stateSet",player]},"phoneSync targets exactly the owning player"] call TEST_fnc_assert;
[((player getVariable "ALSPMC_phoneState") get "reply")==101,"phoneSync keeps its server-local copy for desktop merge"] call TEST_fnc_assert;
[player,0,true] call ALSPMC_fnc_phoneSync;
[((player getVariable "ALSPMC_phoneState") get "reply")==101,"periodic state preserves the last action acknowledgment"] call TEST_fnc_assert;
call ALSPMC_fnc_terminalInit;
private _computer=(ALSPMC_terminals get "h_100_100") select 0;
TEST_messages=[];
[[player,"status","",0,_computer] call ALSPMC_fnc_desktopDo,"registered computer can request status through the shared controller"] call TEST_fnc_assert;
_privatePackets=TEST_messages select {((_x select 1) select 0)=="ALSPMC_fnc_stateSet"};
private _desktopPacket=(_privatePackets select {((_x select 0) select 0)=="ALSPMC_desktopState"}) select 0;
private _desktop=(_desktopPacket select 0) select 1;
[_desktop get "valid" && {_desktop get "licensed"} && {count (_desktop get "bases")==1},"private desktop packet contains the complete authorized phone state"] call TEST_fnc_assert;
[_desktop get "terminalKey"=="h_100_100" && {_desktop get "reply"==101},"desktop merge preserves terminal identity and action acknowledgment"] call TEST_fnc_assert;

private _eastGroup=createGroup [east,true];
[player] joinSilent _eastGroup;
[(([player] call ALSPMC_fnc_questState) get "reason")=="wanted","EAST wanted player is blocked before contract acceptance"] call TEST_fnc_assert;
[player] joinSilent (createGroup [civilian,true]);
[([player] call ALSPMC_fnc_questState) get "canStart","unwanted licensed founder with base can accept"] call TEST_fnc_assert;
[!([player,"questStart","eliminate",8000] call ALSPMC_fnc_phoneDo),"old eliminate request cannot bypass an available contract catalogue"] call TEST_fnc_assert;
[count ALSPMC_questRecords==0,"rejected legacy request creates no quest record"] call TEST_fnc_assert;

ALS_war set ["bases",[["army",[3100,100,0],"outpost",8,"Army"],["army2",[6100,100,0],"outpost",8,"Army 2"]]];
ALS_war set ["own",createHashMapFromArray [["army","Military"],["army2","Military"]]];
ALSPMC_contractSitesCache=createHashMap;
ALSPMC_contractBoards=createHashMap;
ALSPMC_fnc_contractPlan={createHashMapFromArray [["base",[100,100,0]],["site",[3100,100,0]],["source","army"],["owner","Military"],["building",objNull],["indoor",[]],["truckPos",[3100,100,0]],["truckDir",90],["destination",[6100,100,0]]]};
private _board=[player] call ALSPMC_fnc_contractOffers;
(_board get "offers") set [0,["review_convoy","gov_convoy"]];
[[player,"questStart","review_convoy",8001] call ALSPMC_fnc_phoneDo,"native coop acceptance starts the current convoy scenario"] call TEST_fnc_assert;
_crew=["p1"] call ALS_fnc_crewOf;
_job=ALS_coopJobs get (_crew get "job");
[_job getOrDefault ["alspmcCreatedCrew",false],"solo start marks only its auto-created crew"] call TEST_fnc_assert;
player setPos [3100,100,0];
[[player,"questReady","q1",8002] call ALSPMC_fnc_phoneDo,"founder can confirm convoy readiness near source"] call TEST_fnc_assert;
private _truck=_job get "alspmcTruck";
[_truck getVariable ["ALS_unlocked",false],"convoy truck carries the native unlocked marker"] call TEST_fnc_assert;
[[player,"questCancel","q1",8003] call ALSPMC_fnc_phoneDo,"founder can cancel current convoy"] call TEST_fnc_assert;
[count (["p1"] call ALS_fnc_crewOf)==0,"settlement removes the auto-created one-member crew"] call TEST_fnc_assert;
[count ALSPMC_questRecords==1 && {(ALSPMC_questRecords get 1) select 1=="cancelled"},"solo cleanup preserves the completed quest history"] call TEST_fnc_assert;

// Regression: cached sites must reflect live property ownership.
ALSPMC_contractSitesCache=createHashMap;
ALS_houses set ["review_shop",[[5100,100,0],"shop.p3d",150,2,"Town",5000,"Shop","Good"]];
private _sites=["commercial"] call ALSPMC_fnc_contractSites;
ALS_owned set ["review_shop","p2"];
private _stale=["commercial"] call ALSPMC_fnc_contractSites;
private _cachedOwner=(_stale findIf {(_x select 1)=="review_shop"})>=0;
[!_cachedOwner,"cached site list immediately excludes newly purchased property"] call TEST_fnc_assert;
TEST_realTime=TEST_realTime+31;
private _fresh=["commercial"] call ALSPMC_fnc_contractSites;
[(_fresh findIf {(_x select 1)=="review_shop"})<0,"expired site cache excludes newly purchased property"] call TEST_fnc_assert;
